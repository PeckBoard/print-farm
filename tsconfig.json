{
  "compilerOptions": {
    "lib": ["es2020"],
    "types": ["@extism/js-pdk"],
    "target": "es2020",
    "module": "es2020",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*", "test/**/*"],
  "exclude": ["test/shell.test.ts", "test/setup-shell.test.ts", "test/strip3mf.test.ts"]
}
